# Zetaris Lightning REST (the federated data plane)
ZETARIS_BASE_URL=https://<your-codespace>-3000.app.github.dev
ZETARIS_ORG_ID=1
ZETARIS_USERNAME=admin@zetaris.com
ZETARIS_PASSWORD=
ZETARIS_API_KEY=  # optional: skip login when set

# Reasoning provider: "nvidia" (hosted Nemotron, used by the hosted demo)
# or "meterless" (a local Nightshift hotspot - same code path, contract v0.90.0)
SIFT_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL_FAST=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_MODEL_DEEP=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Only when SIFT_PROVIDER=meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=

# Scout contract signing (any random string in production)
SCOUT_SIGNING_KEY=
